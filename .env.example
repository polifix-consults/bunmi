# ==============================================================================
# Olubunmi Ayantunji Portfolio & Policy Platform — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Fill in your project keys from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & API Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anon API Key
SUPABASE_ANON_KEY="your-anon-key-here"

# (Optional) Supabase Secret / Service Role Key (for backend server functions / admin scripts)
SUPABASE_SECRET_KEY="your-secret-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# 2. Mailchimp Newsletter Configuration
# ------------------------------------------------------------------------------
MAILCHIMP_AUDIENCE_ID="your-audience-id-here"
MAILCHIMP_API_KEY="your-api-key-here"

# ------------------------------------------------------------------------------
# 3. Site Identity & Canonical URL
# ------------------------------------------------------------------------------
# The canonical production or preview domain of the site
SITE_URL="https://olubunmiayantunji.com"

# ------------------------------------------------------------------------------
# 4. Contact Form & Email Notifications (Optional / Future Integrations)
# ------------------------------------------------------------------------------
# Destination email for inquiries submitted through the contact form
CONTACT_INBOX_EMAIL=" "

# (Optional) Email provider API key (e.g., Resend, SendGrid, or Postmark)
# RESEND_API_KEY="re_123456789"
