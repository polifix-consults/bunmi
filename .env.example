# ==============================================================================
# Olubunmi Ayantunji Portfolio & Policy Platform — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Fill in your project keys from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & API Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anon API Key
SUPABASE_ANON_KEY="your-anon-key-here"

# (Optional) Supabase Secret / Service Role Key (for backend server functions / admin scripts)
SUPABASE_SECRET_KEY="your-secret-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# 2. Mailchimp Newsletter Configuration
# ------------------------------------------------------------------------------
MAILCHIMP_AUDIENCE_ID="your-audience-id-here"
MAILCHIMP_API_KEY="your-api-key-here"

# ------------------------------------------------------------------------------
# 3. Site Identity & Canonical URL
# ------------------------------------------------------------------------------
# The canonical production or preview domain of the site
SITE_URL="https://olubunmiayantunji.com"

# ------------------------------------------------------------------------------
# 4. Contact Form & Email Notifications (Resend)
# ------------------------------------------------------------------------------
# Destination email for inquiries submitted through the contact form
CONTACT_INBOX_EMAIL="inquiries@olubunmiayantunji.com"

# Resend API Key for transactional emails (order confirmations, notifications)
RESEND_API_KEY="re_your_api_key_here"
# Transactional from email address (must be configured on a verified domain in Resend)
RESEND_FROM_EMAIL="Olubunmi Ayantunji <orders@olubunmiayantunji.com>"

# ------------------------------------------------------------------------------
# 5. Stripe Payment & Webhook Configuration
# ------------------------------------------------------------------------------
# Stripe Secret Key (sk_test_... or sk_live_...) or Restricted API Key
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Stripe Webhook Signing Secret (whsec_...) for verifying webhook signatures
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 6. Book Order & Launch Attendance Configuration
# ------------------------------------------------------------------------------
# Kill switch: set to "true" to enable checkout, "false" to disable
CHECKOUT_ENABLED="false"
# Default price in lowest currency unit (e.g., 4500 cents = $45.00 CAD)
BOOK_PRICE_CENTS=3999
BOOK_CURRENCY="cad"
# Maximum copies per order
MAX_COPIES_PER_ORDER="5"
# Event details displayed in confirmation emails and checkout summaries
EVENT_TITLE="Book Launch and Policy Dialogue"
EVENT_DATE_TEXT="To be announced (attendees will receive an email update)"
EVENT_VENUE_NAME="CB 139, College Avenue Campus, University of Regina"
EVENT_VENUE_ADDRESS="📍 2155 College Ave, Regina, SK"
EVENT_VENUE_TEXT="CB 139, College Avenue Campus, University of Regina, 2155 College Ave, Regina, SK"
EVENT_CITY_COUNTRY="Canada"
CONTACT_SUPPORT_EMAIL="info@olubunmiayantunji.com"
# Secret token to protect internal retry endpoints (e.g., cron retry of failed emails)
INTERNAL_CRON_SECRET="your-secure-internal-cron-secret"

